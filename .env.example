# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google Gemini
GOOGLE_GEMINI_API_KEY=your-gemini-api-key

# App
NEXT_PUBLIC_APP_NAME="Radius AI"

# ВАЖНО: здесь НЕТ переменных для токенов Instagram/Telegram (например
# TELEGRAM_BOT_TOKEN, INSTAGRAM_PAGE_ACCESS_TOKEN, INSTAGRAM_VERIFY_TOKEN).
# Эти токены хранятся динамически в таблице accounts в Supabase и
# добавляются через UI на странице «Аккаунты» — так один и тот же деплой
# обслуживает произвольное количество независимых аккаунтов без правок
# .env и без передеплоя.
